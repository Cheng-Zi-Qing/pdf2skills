# --- LLM provider (any OpenAI-compatible endpoint) ---
# LLM_* takes precedence; SILICONFLOW_* still works for existing setups.
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# LLM_API_KEY=
# LLM_BASE_URL=

# --- MinerU (PDF -> Markdown) ---
MINERU_API_KEY=your_mineru_api_key
MINERU_BASE_URL=https://mineru.net/api/v4/extract/task

# --- Pipeline ---
CHUNK_MAX_TOKENS=30000
CHUNK_MAX_ITERATIONS=3
OUTPUT_LANGUAGE=English
BUCKET_THRESHOLD=0.5

# --- Rate limiting / retries ---
GLM_RATE_LIMIT_SECONDS=3.0
FUSION_RATE_LIMIT_SECONDS=2.0
# LLM_MAX_RETRIES=5
# LLM_BACKOFF_BASE_SECONDS=2
# LLM_BACKOFF_MAX_SECONDS=60
# LLM_JSON_RETRIES=1

# --- Optional model overrides per role ---
# chunking | density | extraction | fusion | skill | router | glossary | embedding
# MODEL_EXTRACTION=Pro/zai-org/GLM-4.7
# MODEL_FUSION=deepseek-ai/DeepSeek-V3
# RATE_LIMIT_EXTRACTION=3.0
# MAX_TOKENS_SKILL=16000

# --- Response cache (or pass --llm-cache to run_pipeline.py) ---
# LLM_CACHE_DIR=./.llm_cache
